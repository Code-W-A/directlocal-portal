{
  "name": "porta-director",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run validate:content",
    "build": "next build --webpack && npm run verify:export",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:content": "tsx scripts/validate-content.ts",
    "verify:export": "NODE_ENV=production tsx scripts/verify-export.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "check": "npm run lint && npm run test && npm run build && npm run typecheck"
  },
  "dependencies": {
    "@next/env": "16.4.0",
    "markdown-it": "15.0.2",
    "next": "16.4.0",
    "nodemailer": "^10.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cheerio": "1.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "lighthouse": "^13.5.0",
    "sharp": "^0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "type": "module"
}
