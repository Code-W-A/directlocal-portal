# Approved production origin. Development and Vercel previews stay noindex.
SITE_URL=https://directlocal.ro
# Production defaults to true; set false to disable indexing for a staging build.
# INDEXING_ENABLED=false

# SMTP: server only. Never prefix these with NEXT_PUBLIC_.
# Local form origin. In production SITE_URL is authoritative.
CONTACT_ORIGIN=http://127.0.0.1:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Public GA4 Measurement ID. Production apex only; opt-in before loading.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
